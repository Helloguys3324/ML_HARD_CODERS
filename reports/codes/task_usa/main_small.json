import json, os, sys

def _find_input():
    here = os.getcwd()
    sd = os.path.dirname(os.path.abspath(__file__)) if "__file__" in globals() else here
    cands = []
    if len(sys.argv) > 1:
        cands.append(sys.argv[1])
    for base in (here, sd):
        cands += [os.path.join(base, "test-input.json"),
                  os.path.join(base, "train-input.json")]
    for c in cands:
        if c and os.path.isfile(c):
            return c
    return None

def main():
    src = _find_input()
    data = {}
    if src:
        try:
            with open(src, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except Exception:
            data = {}
    cal = data.get("calibration") or {}
    text = cal.get("text") or ""
    cal_ids = cal.get("token_ids") or []
    ch_ids = (data.get("challenge") or {}).get("token_ids") or []

    name = "cl100k_base"
    decoded = ""
    try:
        import tiktoken
        if text and cal_ids:
            for cand in ["p50k_base", "cl100k_base", "gpt2", "r50k_base", "o200k_base"]:
                try:
                    if tiktoken.get_encoding(cand).decode(cal_ids) == text:
                        name = cand
                        break
                except Exception:
                    pass
        decoded = tiktoken.get_encoding(name).decode(ch_ids, errors="replace")
    except Exception:
        decoded = ""

    out = {"tokenizer_id": name, "decoded_message": decoded}
    targets = []
    for base in {os.getcwd(), os.path.dirname(os.path.abspath(src)) if src else os.getcwd()}:
        targets.append(os.path.join(base, "test-output.json"))
    for t in targets:
        try:
            with open(t, "w", encoding="utf-8") as fh:
                json.dump(out, fh, ensure_ascii=False, indent=2)
                fh.write("\n")
        except Exception:
            pass

if __name__ == "__main__":
    main()
